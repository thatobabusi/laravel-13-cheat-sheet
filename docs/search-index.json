---
layout: null
permalink: /search-index.json
---
[
  {% for page in site.pages %}
    {% if page.path contains 'cheatsheet' and page.path != 'cheatsheet/README.md' %}
      {
        "id": "{{ page.url | remove: '/' }}",
        "title": "{{ page.path | split: '/' | last | remove: '.md' | replace: '-', ' ' | capitalize }}",
        "url": "{{ page.url | relative_url }}",
        "category": "{{ page.path | split: '/' | [1] }}"
      }{% unless forloop.last %},{% endunless %}
    {% endif %}
  {% endfor %}
]
