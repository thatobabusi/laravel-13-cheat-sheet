{
    "env":  {
                "browser":  true,
                "es2021":  true
            },
    "rules":  {
                  "no-debugger":  "warn",
                  "quotes":  [
                                 "warn",
                                 "single"
                             ],
                  "indent":  [
                                 "warn",
                                 4
                             ],
                  "no-useless-escape":  "warn",
                  "eqeqeq":  [
                                 "warn",
                                 "always"
                             ],
                  "semi":  [
                               "warn",
                               "always"
                           ],
                  "no-console":  "off",
                  "curly":  [
                                "warn",
                                "all"
                            ],
                  "no-unused-vars":  [
                                         "warn",
                                         {
                                             "argsIgnorePattern":  "^_"
                                         }
                                     ]
              },
    "globals":  {
                    "hljs":  "readonly"
                },
    "parserOptions":  {
                          "ecmaVersion":  "latest",
                          "sourceType":  "module"
                      },
    "extends":  "eslint:recommended"
}