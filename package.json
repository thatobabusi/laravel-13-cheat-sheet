{
  "name": "laravel-13-cheat-sheet",
  "version": "1.2.1",
  "description": "Comprehensive Laravel 13 reference with organized categories and full-text search",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint index.html",
    "lint:css": "stylelint assets/**/*.css",
    "lint:js": "eslint assets/scripts.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "dev": "python -m http.server 8000"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^8.54.0",
    "htmlhint": "^1.1.4",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0"
  },
  "keywords": [
    "laravel",
    "php",
    "cheat-sheet",
    "reference",
    "documentation"
  ],
  "author": "Thato Babusi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thatobabusi/laravel-13-cheat-sheet.git"
  }
}
